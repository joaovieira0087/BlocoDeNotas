@using System.Text.RegularExpressions
@model List<Nota>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

   <div class="container mt-4">
       <h2>Bloco de Notas Online</h2>

       <div id="toolbar" class="mb-2"></div>
       <div id="editor" style="height:200px; margin-bottom: 10px"></div>

    <button id="btnSalvar" class="btn btn-primary mb-4">Salvar</button>

       <hr />

       <h4 class="mb-3">Notas Salvas</h4>

       <div id="notasContainer" class="row g-3">
           @if(Model != null)


            {
                @foreach (var nota in Model)
                {
                    var textoLimpo = Regex.Replace(nota.Conteudo, "<.*?>", "");
                    var resumo = textoLimpo.Length > 60 ? textoLimpo.Substring(0, 20) + "..." : textoLimpo;

                    <div class="col-md-3 col-sm-6">
                        <div class="card shadow-sm bloco" id="nota-@nota.Id" onclick="carregarNota(@nota.Id)">
                            <div class="card-body p-2">
                                <p class="card-text small">@resumo</p>
                            <button id="nota-@nota.Id" onclick="excluirBloco(@nota.Id)" type="button" class="btn btn-danger">Apagar</button>

                            </div>
                        </div>
                    </div>
                }
            }
        </div>

   </div>

   <style>
         .bloco {
              cursor: pointer;
              transition: transform 0.2s;
         }
    
         .bloco:hover {
              transform: scale(1.05);
              box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        #editor{
            background-color: #fff;
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 10px;
    }
   </style>

   <script>
       var quill = new Quill("#editor", {
        theme: "snow",
        modulos: {
            toolbar: [
             ['bold', 'italic', 'underline'],
             [{'list': 'ordered'}, {'list': 'bullet'}]
            ]
        }
       });

        let notaIdAtual = null;

    $('#btnSalvar').on('click', function () {

        let conteudo = quill.root.innerHTML;

        if (conteudo.trim() === '' || conteudo === '<p><br></p>') {
            alert('O conteúdo da nota não pode estar vazio.');
            return;
        }

        $.post('/Home/SalvarNota', { id: notaIdAtual, conteudo: conteudo }, function (res) {

            if (!res.sucesso) {
                alert('Erro ao salvar.');
                return;
            }

            if (notaIdAtual) {
                // Atualiza a nota existente
                let card = $(`#nota-${notaIdAtual}`);

                if (card.length) {
                    card.find('.card-text').html(res.resumo);
                }

            } else {
                // Adiciona nova nota
                $('#notasContainer').prepend(`
                    <div class="col-md-3 col-sm-6">
                        <div class="card shadow-sm bloco" id="nota-${res.id}" onclick="carregarNota(${res.id})">
                            <div class="card-body p-2">
                                <p class="card-text small">${res.resumo}</p>
                            </div>
                        </div>
                    </div>
                `);
            }

            notaIdAtual = null;
            quill.setContents([]);
        });
    });

    function carregarNota (id) {
        $.get('/Home/ObterNota', {id: id }, function (res) {
            quill.root.innerHTML = res.conteudo;
            notaIdAtual = id;
        });
    }

        function excluirBloco(id) {
        $.ajax({
            url: '/Home/ExcluirBloco',
            type: 'DELETE', // Especifica o método HTTP como DELETE
            data: {
                id: id
            },
            success: function(res) {
                console.log("Sucesso:", res);

            },
            error: function(xhr, status, error) {
                console.error("Erro:", error);
            }
        });
    }
    

   </script>
